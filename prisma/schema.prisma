generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  status    String   @default("active") // active, suspended, deleted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
  mailboxAuthorizations MailboxAuthorization[]

  @@map("tenants")
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  email     String
  authProvider String? // oauth_provider used for authentication
  authSubject String? // subject claim from OAuth provider
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mailboxAuthorizations MailboxAuthorization[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model MailboxAuthorization {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String   @db.Uuid
  userId               String   @db.Uuid
  mailboxId            String   // platform-assigned mailbox ID
  platform             String   // gmail, outlook
  scopeSet             Json     // array of minimal scopes
  consentGrantedAt     DateTime
  lastTokenRefreshedAt DateTime?
  credentialHandle     String   // opaque reference to vault, never raw token
  status               String   @default("active") // active, revoked, expired
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentGrants ConsentGrant[]

  @@unique([tenantId, userId, mailboxId, platform])
  @@index([tenantId])
  @@index([userId])
  @@index([mailboxId])
  @@index([status])
  @@map("mailbox_authorizations")
}

model ConsentGrant {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mailboxAuthorizationId String   @db.Uuid
  scopeSet               Json     // array of scopes granted
  grantedAt              DateTime
  consentProofUrl        String?  // URL for compliance audit trail
  createdAt              DateTime @default(now())

  mailboxAuthorization MailboxAuthorization @relation(fields: [mailboxAuthorizationId], references: [id], onDelete: Cascade)

  @@index([mailboxAuthorizationId])
  @@map("consent_grants")
}

model OAuthProvider {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platform              String   @unique // gmail, outlook
  clientId              String
  clientSecretVaultRef  String   // opaque reference to vault
  redirectUri           String
  minScopes             Json     // minimum required scopes per platform
  adminScopes           Json?    // optional admin/application-level scopes
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("oauth_providers")
}

// Placeholder tables for future stages
model MessageQueue {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  messageId String
  status    String   @default("pending") // pending, processing, completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("message_queue")
}

model Metrics {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  metric    String
  value     Float
  timestamp DateTime @default(now())

  @@index([tenantId])
  @@index([timestamp])
  @@map("metrics")
}

model Plan {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String   @unique
  stripePriceId     String   @unique
  mailboxLimit      Int
  llmTierCeiling    String   // tier-1-only, tier-2-cheap, tier-3-frontier
  features          Json     // flexible feature set per plan
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @db.Uuid
  currentPlanId   String   @db.Uuid
  status          String   @default("active") // active, past_due, suspended, canceled
  planVersion     Int      @default(1) // versioning for plan changes
  planChangedAt   DateTime?
  stripeCustomerId String?
  stripeSubscriptionId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  currentPlan Plan @relation(fields: [currentPlanId], references: [id])

  @@unique([tenantId]) // only one subscription per tenant
  @@index([tenantId])
  @@index([status])
  @@map("subscriptions")
}

model UsageMeter {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @db.Uuid
  meterType          String   // mailbox_synced, llm_tokens, digests_sent
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  usageCount         BigInt   @default(0)
  overageThreshold   BigInt
  overageDetected    Boolean  @default(false) // flag to prevent duplicate events
  lastIncrementedAt  DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, meterType, billingPeriodStart, billingPeriodEnd])
  @@index([tenantId, meterType])
  @@index([billingPeriodStart])
  @@map("usage_meters")
}

model SubscriptionBillingEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid
  eventType    String   // webhook_received, overage_detected, payment_failed, plan_changed
  stripeEventId String?  @unique
  payload      Json
  processed    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([stripeEventId])
  @@index([processed])
  @@map("subscription_billing_events")
}

// Mailbox Ingestion bounded context

model MailboxConnection {
  id                    String   @id @default(cuid())
  tenantId              String   @map("tenant_id")
  mailboxId             String   @map("mailbox_id") // platform-assigned (Gmail address or Outlook OID)
  platform              String   // "gmail" | "outlook"
  status                String   @default("active") // active|sync_failed|revoked
  
  // Watch/Subscription state
  watchSubscriptionId   String?  @map("watch_subscription_id")
  watchExpiresAt        DateTime? @map("watch_expires_at")
  syncCursorValue       String?  @map("sync_cursor_value") // Gmail historyId or Outlook deltaLink
  
  credentialHandleId    String   @map("credential_handle_id") // FK to MailboxAuthorization.credentialHandle
  lastWebhookAt         DateTime? @map("last_webhook_at")
  lastSyncAt            DateTime? @map("last_sync_at")
  syncFailureCount      Int      @default(0) @map("sync_failure_count")
  
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingestedMessages      IngestedMessage[]
  syncEventLogs         SyncEventLog[]

  @@unique([tenantId, mailboxId, platform])
  @@index([tenantId])
  @@index([status])
  @@map("mailbox_connections")
}

model IngestedMessage {
  id                    String   @id @default(cuid())
  tenantId              String   @map("tenant_id")
  messageId             String   @map("message_id") // internal UUID
  mailboxId             String   @map("mailbox_id") // FK to MailboxConnection
  platformMessageId     String   @map("platform_message_id") // Gmail msg ID or Outlook msg ID
  platform              String   // "gmail" | "outlook"
  
  normalizedEnvelope    Json     @map("normalized_envelope") // MessageEnvelope value object
  bodyRefId             String?  @map("body_ref_id") // FK to MessageBodyRef
  
  createdAt             DateTime @default(now()) @map("created_at")
  
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bodyRef               MessageBodyRef? @relation(fields: [bodyRefId], references: [id])

  @@unique([tenantId, messageId])
  @@unique([tenantId, platformMessageId, platform, mailboxId])
  @@index([tenantId])
  @@index([mailboxId])
  @@map("ingested_messages")
}

model MessageBodyRef {
  id                    String   @id @default(cuid())
  tenantId              String   @map("tenant_id")
  messageId             String   @map("message_id") // FK to IngestedMessage
  bodyHash              String   @map("body_hash") // SHA256 of body
  bodyStorageRef        String   @map("body_storage_ref") // S3 URI or file path
  ttlExpiresAt          DateTime @map("ttl_expires_at") // When body should be deleted
  
  createdAt             DateTime @default(now()) @map("created_at")
  
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingestedMessages      IngestedMessage[]

  @@index([tenantId])
  @@index([ttlExpiresAt])
  @@map("message_body_refs")
}

model SyncEventLog {
  id                    String   @id @default(cuid())
  tenantId              String   @map("tenant_id")
  mailboxConnectionId   String   @map("mailbox_connection_id")
  eventType             String   // webhook_received|delta_sync_completed|renewal_failed|rate_limited
  details               Json     @default("{}")
  
  createdAt             DateTime @default(now()) @map("created_at")
  
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mailboxConnection     MailboxConnection @relation(fields: [mailboxConnectionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([mailboxConnectionId])
  @@index([eventType])
  @@map("sync_event_logs")
}

// Outbox for transactional event publishing
model OutboxEvent {
  id                    String   @id @default(cuid())
  tenantId              String   @map("tenant_id")
  aggregateId           String   @map("aggregate_id")
  aggregateType         String   @map("aggregate_type") // IngestedMessage
  eventType             String   @map("event_type") // MessageIngested
  payload               Json
  published             Boolean  @default(false)
  
  createdAt             DateTime @default(now()) @map("created_at")
  publishedAt           DateTime? @map("published_at")
  
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([published])
  @@map("outbox_events")
}

// Classification context
enum Category {
  PERSONAL
  WORK
  MARKETING
  FINANCE
  HEALTH
  SHOPPING
  TRAVEL
  SOCIAL
  NEEDS_REPLY
}

model MessageLabel {
  id              String    @id @default(cuid())
  tenant_id       String
  message_id      String
  category        Category
  confidence_score Float    @db.Decimal(3, 2) // 0.00-1.00
  source_tier     String    // "rule", "cheap_llm", "frontier_llm"
  classifier_version String
  created_at      DateTime  @default(now())

  ingested_message IngestedMessage @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@unique([message_id, category])
  @@index([tenant_id])
  @@index([message_id])
}

model PipelineVersion {
  id                    String    @id @default(cuid())
  version               String    @unique
  description           String?
  rule_prompt_hash      String?
  llm_model_tier        String    // "haiku", "sonnet", "opus"
  cheap_llm_model       String    @default("claude-3-5-haiku-20241022")
  frontier_llm_model    String    @default("claude-3-5-sonnet-20241022")
  created_at            DateTime  @default(now())
  deployed_at           DateTime?
  canary_cohorts        Json      @default("[]") // array of tenant IDs or percentage slices
  active_cohort_fraction Float    @default(0.0)  // 0.0-1.0
  is_active             Boolean   @default(false)

  @@index([is_active])
  @@index([deployed_at])
}

model GoldenDataset {
  id               String    @id @default(cuid())
  external_message_id String
  expected_labels  Json      // array of Category enum values
  message_content  String?   @db.Text
  created_at       DateTime  @default(now())
  archived_at      DateTime?

  @@index([archived_at])
}

model ShadowEvalRun {
  id                      String    @id @default(cuid())
  tenant_id               String
  pipeline_version_from   String    // semver
  pipeline_version_to     String    // semver (candidate)
  eval_date               DateTime  @default(now())
  per_category_metrics    Json      // { "PERSONAL": { precision: 0.9, recall: 0.85, f1: 0.87 }, ... }
  regression_detected     Boolean   @default(false)
  regression_details      Json?     // which categories regressed and by how much
  approved_at             DateTime?
  approval_notes          String?
  created_at              DateTime  @default(now())

  @@index([tenant_id])
  @@index([approved_at])
}
