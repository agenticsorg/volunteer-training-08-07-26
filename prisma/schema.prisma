generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  status    String   @default("active") // active, suspended, deleted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@map("tenants")
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// Placeholder tables for future stages
model MessageQueue {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  messageId String
  status    String   @default("pending") // pending, processing, completed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([status])
  @@map("message_queue")
}

model Metrics {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  metric    String
  value     Float
  timestamp DateTime @default(now())

  @@index([tenantId])
  @@index([timestamp])
  @@map("metrics")
}

model Plan {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String   @unique
  stripePriceId     String   @unique
  mailboxLimit      Int
  llmTierCeiling    String   // tier-1-only, tier-2-cheap, tier-3-frontier
  features          Json     // flexible feature set per plan
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @db.Uuid
  currentPlanId   String   @db.Uuid
  status          String   @default("active") // active, past_due, suspended, canceled
  planVersion     Int      @default(1) // versioning for plan changes
  planChangedAt   DateTime?
  stripeCustomerId String?
  stripeSubscriptionId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  currentPlan Plan @relation(fields: [currentPlanId], references: [id])

  @@unique([tenantId]) // only one subscription per tenant
  @@index([tenantId])
  @@index([status])
  @@map("subscriptions")
}

model UsageMeter {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @db.Uuid
  meterType          String   // mailbox_synced, llm_tokens, digests_sent
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  usageCount         BigInt   @default(0)
  overageThreshold   BigInt
  overageDetected    Boolean  @default(false) // flag to prevent duplicate events
  lastIncrementedAt  DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, meterType, billingPeriodStart, billingPeriodEnd])
  @@index([tenantId, meterType])
  @@index([billingPeriodStart])
  @@map("usage_meters")
}

model SubscriptionBillingEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid
  eventType    String   // webhook_received, overage_detected, payment_failed, plan_changed
  stripeEventId String?  @unique
  payload      Json
  processed    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([stripeEventId])
  @@index([processed])
  @@map("subscription_billing_events")
}
